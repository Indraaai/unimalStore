generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SellerStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum PaymentType {
  MEMBERSHIP
  FEATURED_ADS
}

enum PaymentStatus {
  PENDING
  AWAITING_VERIFICATION
  APPROVED
  REJECTED
  EXPIRED
}

model User {
  id       String     @id @default(cuid())
  name     String
  email    String     @unique
  password String
  role     Role       @default(SELLER)
  status   UserStatus @default(ACTIVE)

  sellerProfile SellerProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SellerProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  storeName      String
  storeSlug      String       @unique
  whatsappNumber String
  description    String?
  logoUrl        String?
  status         SellerStatus @default(PENDING_VERIFICATION)
  rejectionReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  products Product[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id         String @id @default(cuid())
  sellerId   String
  categoryId String

  title       String
  slug        String        @unique
  description String
  price       Int
  type        ProductType   @default(PRODUCT)
  status      ProductStatus @default(PENDING)

  isFeatured    Boolean   @default(false)
  featuredUntil DateTime?

  viewsCount Int @default(0)
  leadsCount Int @default(0)

  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category      @relation(fields: [categoryId], references: [id])

  images ProductImage[]
  leads  Lead[]
  views  ProductView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  imageUrl  String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Lead {
  id        String @id @default(cuid())
  productId String
  sellerId  String

  ipAddress String?
  userAgent String?
  referrer  String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ProductView {
  id        String @id @default(cuid())
  productId String
  sellerId  String

  ipAddress String?
  userAgent String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model MembershipPlan {
  id                String  @id @default(cuid())
  name              String
  price             Int
  durationDays      Int
  productLimit      Int
  canUseFeaturedAds Boolean @default(false)
  description       String?
  isActive          Boolean @default(true)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id               String  @id @default(cuid())
  sellerId         String
  membershipPlanId String?
  productId        String?

  type          PaymentType
  amount        Int
  proofImageUrl String?
  status        PaymentStatus @default(PENDING)
  adminNote     String?

  approvedAt DateTime?
  rejectedAt DateTime?

  seller         SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  membershipPlan MembershipPlan? @relation(fields: [membershipPlanId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
